{
  "name": "voice-notes",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "test:e2e": "node scripts/make-fixture.mjs && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:bundle && npm run check:contrast"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
